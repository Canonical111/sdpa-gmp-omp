# build artifacts -- this tree is configured and built in place
.deps/
# automake's dependency-tracking temporaries. `.Tpo` was committed by accident on
# 2026-08-20 and reached the public repository carrying ~900 absolute paths from the
# author's machine; `.deps/` and `*.o` did not cover a `.Tpo` at the tree root.
*.Tpo
.Tpo
# Generated by autoreconf, and therefore not tracked -- consistent with configure,
# Makefile.in, compile, config.guess, config.sub, install-sh, missing and depcomp, which
# this file already excludes. Upstream ships no ./configure, so every build path runs
# `autoreconf -fi` and regenerates both of these; tracking them only produced spurious
# working-tree diffs and a documented restore procedure that need not exist.
/INSTALL
/aclocal.m4
.dirstamp
*.o
*.a
*.lo
*.la
*.Po
*.Plo
sdpa_gmp
Makefile
Makefile.in
config.status
config.log
configure~
aclocal.m4
autom4te.cache/
libtool
stamp-h1
*.result
*~
external/
spooles/
mplapack/.deps/
mplapack/.dirstamp
# autotools output regenerated by autoreconf -fi (verified: exactly these appear untracked)
compile
config.guess
config.sub
configure
depcomp
install-sh
missing

# macOS duplicate copies of the built binary ("sdpa_gmp 2", "sdpa_gmp 3", ...)
sdpa_gmp [0-9]*

# OS and editor noise -- never track these. A tracked .DS_Store was found in the
# dd fork and removed; these rules exist so it cannot come back in any of them.
.DS_Store
.DS_Store?
._*
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes
__MACOSX/
Thumbs.db
ehthumbs.db
desktop.ini
*.swp
*.swo
*~
.vscode/
.idea/

# decompressed test inputs (CI and local runs produce these from the tracked .xz)
SDPLIB/data/*.dat-s
/Canonical_example.dat-s
